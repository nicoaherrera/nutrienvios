# Variables de entorno del backend (Vercel > Settings > Environment Variables).
# NUNCA usar prefijo VITE_ acá: estas claves solo viven en las funciones serverless.

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NO la anon key)

# Tokens de acceso de la app (inventar dos strings largos y distintos)
TOKEN_TIENDA=cambiame-token-tienda
TOKEN_REPARTIDOR=cambiame-token-repartidor

# Integración con Tiendanube (aviso al vendedor por pedidos de zona propia)
# Client ID / Secret: Partners Portal (partners.tiendanube.com) > tu app > Datos básicos
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=
# Estos dos los tira /api/tiendanube-oauth la primera vez que se instala la app:
TIENDANUBE_ACCESS_TOKEN=
TIENDANUBE_STORE_ID=

# Bot de Telegram para avisarle al vendedor (gratis, sin riesgo de banear WhatsApp)
# Token: hablarle a @BotFather en Telegram, /newbot
# Chat ID: el vendedor le manda un mensaje al bot y se consulta con getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_VENDEDOR=
